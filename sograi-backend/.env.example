# ==========================================
# Provedor de IA (Padrão: Gemini - Gratuito)
# ==========================================
# Obtenha sua chave gratuita em: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# LLM selecionado: gemini, azure_chat, azure_codex ou ollama
DEFAULT_LLM_PROVIDER=gemini

# ==========================================
# Azure DevOps (Obrigatório para consultar a PR)
# ==========================================
# Personal Access Token (PAT) com escopo de leitura de Code (Read)
AZURE_DEVOPS_TOKEN=
AZURE_DEVOPS_ORG=

# ==========================================
# Azure OpenAI (Opcional - caso queira usar)
# ==========================================
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=

# ==========================================
# Ollama (Opcional - caso queira 100% offline)
# ==========================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ==========================================
# PostgreSQL (Docker)
# ==========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=code_review
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/code_review?schema=public"
