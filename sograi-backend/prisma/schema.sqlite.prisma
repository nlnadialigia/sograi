datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model PullRequest {
  id                 Int              @id @default(autoincrement())
  pullRequestId      String           @map("pull_request_id")
  organization       String?
  project            String?
  repository         String?
  title              String?
  author             String?
  sourceBranch       String?          @map("source_branch")
  targetBranch       String?          @map("target_branch")
  status             String?
  decision           String?
  totalFilesChanged  Int              @default(0) @map("total_files_changed")
  filesWithIssues    Int              @default(0) @map("files_with_issues")
  durationSeconds    Float?         @map("duration_seconds")
  executiveSummary   String?          @map("executive_summary")
  riskLevel          String?          @default("MEDIO") @map("risk_level")
  isArchived         Boolean          @default(false) @map("is_archived")
  iteration          Int              @default(1)
  timeToFix          String?          @map("time_to_fix")
  executiveVerdict   String?          @map("executive_verdict")
  changeSummary      String?          @map("change_summary")
  recommendation     String?
  executiveMarkdown  String?          @map("executive_markdown")
  specMarkdown       String?          @map("spec_markdown")
  fullMarkdown       String?          @map("full_markdown")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at")

  fileReviews        PrFileReview[]

  @@unique([organization, project, repository, pullRequestId], map: "uk_pull_requests_repo_pr")
  @@index([pullRequestId], map: "idx_pr_id")
  @@index([repository], map: "idx_pr_repo")
  @@map("pull_requests")
}

model PrFileReview {
  id            Int            @id @default(autoincrement())
  prId          Int            @map("pr_id")
  filePath      String         @map("file_path")
  decision      String
  changeType    String?        @default("edit") @map("change_type")
  justification String?
  rawAnalysis   Json?          @map("raw_analysis")
  fileLines     Int?           @default(0) @map("file_lines")
  fileBytes     Int?           @default(0) @map("file_bytes")
  createdAt     DateTime       @default(now()) @map("created_at")

  pullRequest   PullRequest    @relation(fields: [prId], references: [id], onDelete: Cascade)
  issues        PrFileIssue[]
  agentReviews  AgentReview[]

  @@index([prId], map: "idx_file_pr_id")
  @@map("pr_file_reviews")
}

model PrFileIssue {
  id            Int          @id @default(autoincrement())
  fileReviewId  Int          @map("file_review_id")
  agentCategory String       @map("agent_category")
  severity      String
  title         String
  description   String?
  lineReference String?      @map("line_reference")
  suggestedCode String?      @map("suggested_code")
  createdAt     DateTime     @default(now()) @map("created_at")

  fileReview    PrFileReview @relation(fields: [fileReviewId], references: [id], onDelete: Cascade)

  @@index([fileReviewId], map: "idx_issue_file_id")
  @@map("pr_file_issues")
}

model AgentReview {
  id           Int          @id @default(autoincrement())
  fileReviewId Int          @map("file_review_id")
  agentName    String       @map("agent_name")
  issuesText   String?      @map("issues_text")
  decision     String
  createdAt    DateTime     @default(now()) @map("created_at")

  fileReview   PrFileReview @relation(fields: [fileReviewId], references: [id], onDelete: Cascade)

  @@index([fileReviewId], map: "idx_agent_file_id")
  @@map("agent_reviews")
}

model PrTrackingItem {
  id                     Int       @id @default(autoincrement())
  pullRequestId          String    @map("pull_request_id")
  organization           String
  project                String
  repository             String
  filePath               String    @map("file_path")
  initialDecision        String    @map("initial_decision")
  initialIssueTitle      String    @map("initial_issue_title")
  initialIssueDescription String   @map("initial_issue_description")
  currentStatus          String    @default("PENDING") @map("current_status")
  resolutionNotes        String?   @map("resolution_notes")
  lastIterationChecked   Int       @default(1) @map("last_iteration_checked")
  firstIdentifiedAt      DateTime  @default(now()) @map("first_identified_at")
  resolvedAt             DateTime? @map("resolved_at")
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at")

  @@unique([organization, project, repository, pullRequestId, filePath], map: "uk_tracking_item")
  @@index([pullRequestId, repository], map: "idx_tracking_pr")
  @@map("pr_tracking_items")
}

model ManualPendingItem {
  id              Int       @id @default(autoincrement())
  pullRequestId   String    @map("pull_request_id")
  repository      String
  filePath        String    @map("file_path")
  title           String
  description     String
  itemType        String    @default("TECH_DEBT") @map("item_type")
  priority        String    @default("MEDIUM")
  status          String    @default("PENDING")
  authorName      String?   @default("Tech Lead") @map("author_name")
  origin          String    @default("MANUAL")
  resolvedByPr    String?   @map("resolved_by_pr")
  resolutionNotes String?   @map("resolution_notes")
  resolvedAt      DateTime? @map("resolved_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  history         PendingItemHistory[]

  @@index([pullRequestId, repository], map: "idx_manual_pending_pr")
  @@index([repository, filePath], map: "idx_pending_repo_file")
  @@index([status], map: "idx_manual_pending_status")
  @@map("pr_manual_pending_items")
}

model PendingItemHistory {
  id            Int      @id @default(autoincrement())
  pendingItemId Int      @map("pending_item_id")
  pullRequestId String   @map("pull_request_id")
  prTitle       String?  @map("pr_title")
  author        String?
  iteration     Int      @default(1)
  decision      String   @default("REPROVADO")
  justification String?
  unresolvedAt  DateTime @default(now()) @map("unresolved_at")

  pendingItem   ManualPendingItem @relation(fields: [pendingItemId], references: [id], onDelete: Cascade)

  @@index([pendingItemId], map: "idx_pending_history_item_id")
  @@index([pullRequestId], map: "idx_pending_history_pr_id")
  @@map("pr_pending_item_history")
}

model SystemSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  category    String   @default("general")
  isSecret    Boolean  @default(false) @map("is_secret")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([category], map: "idx_setting_category")
  @@map("system_settings")
}

