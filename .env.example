# ==============================================================================
# SogrAI - Configurações Globais do Ambiente
# ==============================================================================

# Banco de Dados PostgreSQL (Local ou Docker)
POSTGRES_USER=sograi
POSTGRES_PASSWORD=sograi123
POSTGRES_DB=sograi_db
POSTGRES_PORT=5433
DATABASE_URL="postgresql://sograi:sograi123@localhost:5433/sograi_db?schema=public"

# Inteligência Artificial - Google Gemini API
# Obtenha sua chave gratuitamente em: https://aistudio.google.com/
GEMINI_API_KEY=sua_chave_gemini_aqui

# Integração Azure DevOps
AZURE_DEVOPS_ORG=sua_organizacao
AZURE_DEVOPS_PROJECT=seu_projeto
AZURE_DEVOPS_TOKEN=seu_personal_access_token_azure

# Integração GitHub
# Personal Access Token com escopo 'repo'
GITHUB_TOKEN=seu_personal_access_token_github

# Portas dos Serviços
PORT=3333
VITE_API_URL=http://localhost:3333
